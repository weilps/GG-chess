{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChessMate",
  "version": "0.1.0",
  "identifier": "app.chessmate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChessMate",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Guillaume Gaudin",
    "copyright": "Copyright © 2026 Guillaume Gaudin",
    "shortDescription": "Private, local-first chess analysis and training",
    "longDescription": "ChessMate analyzes standard chess games locally with Stockfish and turns saved reviews into private training.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRUJEQUEzMDA3Rjc0ODUKUldTRmRIOEFvOXJyM3ZJM3hrRXVoMmVNL1FSa3g2U2tqMVd3MlliRlhwSUFJZDlhSzJvZDFmMTMK",
      "endpoints": [
        "https://github.com/weilps/GG-chess/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
